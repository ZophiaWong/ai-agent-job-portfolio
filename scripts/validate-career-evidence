#!/usr/bin/env python3
"""Validate the versioned career evidence tables."""

from __future__ import annotations

import argparse
from pathlib import Path

from career_evidence_lib import EvidenceError, validate_tables


def parse_project_roots(values: list[str]) -> dict[str, Path]:
    roots: dict[str, Path] = {}
    for value in values:
        if "=" not in value:
            raise EvidenceError(f"invalid --project-root {value!r}; use name=/absolute/path")
        name, raw_path = value.split("=", 1)
        roots[name] = Path(raw_path).expanduser().resolve()
    return roots


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate career evidence CSV tables.")
    parser.add_argument("--root", default=".")
    parser.add_argument("--project-root", action="append", default=[])
    args = parser.parse_args()
    root = Path(args.root).resolve()
    try:
        _, errors = validate_tables(root, parse_project_roots(args.project_root))
    except EvidenceError as exc:
        print(f"career evidence invalid: {exc}")
        return 1
    if errors:
        print("Career evidence invalid:")
        for error in errors:
            print(f"- {error}")
        return 1
    print("Career evidence valid.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
