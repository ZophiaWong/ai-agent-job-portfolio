#!/usr/bin/env python3
"""Match a confirmed job requirement payload to versioned project evidence."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from career_evidence_lib import (
    EVIDENCE_LEVELS,
    EvidenceError,
    LEVEL_RANK,
    PROJECT_COMMITS,
    PROJECT_ORDER,
    ROLE_TRACKS,
    best_claim,
    bullet_is_usable,
    json_dump,
    table_fingerprint,
    validate_tables,
)


def validate_input(payload: dict) -> None:
    if payload.get("schema_version") != 1:
        raise EvidenceError("input schema_version must be 1")
    if not payload.get("job_id"):
        raise EvidenceError("input job_id is required")
    if payload.get("role_track") not in ROLE_TRACKS:
        raise EvidenceError("input role_track must be a formal role track")
    if payload.get("requirements_confirmed") is not True:
        raise EvidenceError("requirements_confirmed must be true before matching")
    requirements = payload.get("requirements")
    if not isinstance(requirements, list):
        raise EvidenceError("requirements must be a list")
    seen: set[str] = set()
    for requirement in requirements:
        requirement_id = requirement.get("requirement_id")
        if not requirement_id or requirement_id in seen:
            raise EvidenceError(f"requirement_id must be unique and non-empty: {requirement_id}")
        seen.add(requirement_id)
        if requirement.get("importance") not in {"must", "nice"}:
            raise EvidenceError(f"invalid importance for {requirement_id}")
        if not requirement.get("source_quote"):
            raise EvidenceError(f"source_quote is required for {requirement_id}")


def select_bullets(tables: dict, role_track: str, project: str, limit: int) -> list[dict]:
    claims_by_id = {claim["claim_id"]: claim for claim in tables["claims"] if claim["project"] == project}
    candidates = [
        bullet for bullet in tables["bullets"]
        if bullet["project"] == project
        and bullet["role_track"] == role_track
        and bullet_is_usable(bullet, claims_by_id)
    ]
    candidates.sort(key=lambda bullet: (int(bullet["display_order"]), bullet["language"], bullet["bullet_id"]))
    return candidates[:limit]


def main() -> int:
    parser = argparse.ArgumentParser(description="Match a confirmed job payload to career evidence.")
    parser.add_argument("--root", default=".")
    parser.add_argument("--input", required=True)
    parser.add_argument("--output", required=True)
    args = parser.parse_args()
    root = Path(args.root).resolve()
    try:
        payload = json.loads(Path(args.input).read_text(encoding="utf-8"))
        validate_input(payload)
        tables, errors = validate_tables(root, {}, check_external_paths=False)
        if errors:
            raise EvidenceError("career evidence tables invalid: " + "; ".join(errors))
    except (EvidenceError, OSError, json.JSONDecodeError) as exc:
        print(f"match failed: {exc}")
        return 1

    capabilities = {row["capability_id"] for row in tables["capabilities"]}
    claims = tables["claims"]
    requirement_matches: list[dict] = []
    hard_gaps: list[str] = []
    adjacent_risks: list[str] = []
    unassessed: list[str] = []
    unmapped: list[str] = []
    forbidden: set[str] = set()
    for requirement in payload["requirements"]:
        requirement_id = requirement["requirement_id"]
        capability_id = requirement.get("capability_id")
        if not capability_id or capability_id not in capabilities or requirement.get("unmapped_label"):
            unmapped.append(requirement_id)
            requirement_matches.append({
                "requirement_id": requirement_id,
                "capability_id": capability_id,
                "importance": requirement["importance"],
                "source_quote": requirement["source_quote"],
                "status": "unmapped",
                "projects": {project: {"status": "unmapped", "claim": None} for project in PROJECT_COMMITS},
            })
            continue
        projects: dict[str, dict] = {}
        statuses: list[str] = []
        for project in PROJECT_COMMITS:
            claim = best_claim(claims, project, capability_id)
            status = claim["evidence_level"] if claim else "unassessed"
            statuses.append(status)
            if claim:
                forbidden.add(claim["forbidden"])
            projects[project] = {"status": status, "claim": claim}
        if "unassessed" in statuses:
            unassessed.append(requirement_id)
        if requirement["importance"] == "must" and statuses == ["gap", "gap"]:
            hard_gaps.append(requirement_id)
        if requirement["importance"] == "must" and "adjacent" in statuses and not any(status in {"verified_direct", "direct_implementation"} for status in statuses):
            adjacent_risks.append(requirement_id)
        requirement_matches.append({
            "requirement_id": requirement_id,
            "capability_id": capability_id,
            "importance": requirement["importance"],
            "source_quote": requirement["source_quote"],
            "status": "matched",
            "projects": projects,
        })

    unassessed = sorted(set(unassessed))
    hard_gaps = sorted(set(hard_gaps))
    adjacent_risks = sorted(set(adjacent_risks))
    unmapped = sorted(set(unmapped))

    primary, secondary = PROJECT_ORDER[payload["role_track"]]
    primary_bullets = select_bullets(tables, payload["role_track"], primary, 3)
    secondary_bullets = select_bullets(tables, payload["role_track"], secondary, 2)
    if hard_gaps:
        readiness = "hard-gap"
    elif unassessed or unmapped:
        readiness = "needs-assessment"
    elif adjacent_risks:
        readiness = "adjacent-heavy"
    else:
        readiness = "strong"

    matched_evidence = {
        evidence_id
        for requirement in requirement_matches
        for project_match in requirement.get("projects", {}).values()
        if project_match.get("claim")
        for evidence_id in [
            row["evidence_id"]
            for row in tables["evidence"]
            if row["claim_id"] == project_match["claim"]["claim_id"]
        ]
    }
    output = {
        "schema_version": 1,
        "job_id": payload["job_id"],
        "role_track": payload["role_track"],
        "evidence_fingerprint": table_fingerprint(root),
        "project_commits": PROJECT_COMMITS,
        "technical_readiness": readiness,
        "primary_project": primary,
        "secondary_project": secondary,
        "hard_gaps": hard_gaps,
        "adjacent_risks": adjacent_risks,
        "unassessed": unassessed,
        "unmapped": unmapped,
        "requirements": requirement_matches,
        "evidence": sorted(matched_evidence),
        "bullets": {
            "primary": primary_bullets,
            "secondary": secondary_bullets,
        },
        "forbidden_claims": sorted(item for item in forbidden if item),
        "verification_reminders": sorted({
            claim["limitations"]
            for claim in claims
            if any(
                match.get("claim") and match["claim"]["claim_id"] == claim["claim_id"]
                for requirement in requirement_matches
                for match in requirement.get("projects", {}).values()
            )
        }),
        "demo_evidence_ids": sorted({
            evidence_id
            for bullet in primary_bullets + secondary_bullets
            for evidence_id in bullet["demo_evidence_ids"].split(";")
            if evidence_id
        }),
    }
    json_dump(Path(args.output), output)
    print(f"match written: {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
